# GraphKey — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Session ─────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_HEX_STRING

# ── PBKDF2 ──────────────────────────────────────────────────────
# NIST SP 800-132 recommends ≥ 210,000 for SHA-256 (2024 guidance)
PBKDF2_ITERATIONS=210000
